{
  "info": {
    "name": "AI WeatherWise API",
    "description": "Postman collection for the AI WeatherWise backend (V1 scope: auth, favorite locations, public weather, authenticated AI insights, health check). Run requests top-to-bottom within a folder; login and location-create requests auto-save {{token}} and {{locationId}} for subsequent requests via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userBToken",
      "value": ""
    },
    {
      "key": "locationId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "adminUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('success true and status ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.timestamp).to.exist;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
