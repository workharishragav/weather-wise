                  "const body = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.test('password not leaked', () => pm.expect(body.data.password).to.be.undefined);",
                  "pm.test('default role is \"reader\"', () => pm.expect(pm.response.json().data.role).to.eql('reader'));",
